@page "/mission/{MissionRef}"

@using Models
@using Services

@inject HttpClient Http
@inject IArticlesService articlesService
@inject IMarkdownService markdownService
@inject IMissionsService missionsService
@inject IVideoService videoService

<web.Shared.PageTitle Title="@missionData?.Name" />

@if (missionData == null)
{
    <h1>'@MissionName'</h1>
    @MissionsBreadcrumb

    <div class="loading">Loading...</div>
} else
{
    <h1><span class="oi oi-flag" aria-hidden="true"></span>
        @missionData.Name</h1>
    @MissionsBreadcrumb

    @if (!string.IsNullOrEmpty(missionData.ContentUrl))
    {
        @* Hidden until the summary markdown has actually loaded, so a missing file shows nothing *@
        <div class="mission-summary @(hasSummary ? string.Empty : "collapse")">
            <hr />
            <web.Controls.MarkdownView ContentUrl="@missionData.ContentUrl"
                                       ContentLoaded="@((bool loaded) => hasSummary = loaded)" />
        </div>
    }

    @if (articleData?.Any() == true || relatedMissions.Any() || videoData.Any())
    {
        <div class="related-articles">
        <hr />
        <h5>Related:</h5>
        <web.Controls.RelatedBreadcrumbList Articles=@articleData Missions=@relatedMissions Videos=@videoData />
        </div>
    }
}

@code {

    [Parameter]
    public string MissionRef { get; set; }    

    private Mission missionData;
    private Article[] articleData;
    private Mission[] relatedMissions = Array.Empty<Mission>();
    private Video[] videoData = Array.Empty<Video>();
    private bool hasSummary;

    private string MissionName => missionData?.Name ?? $"Mission '{MissionRef}'";

    private string loadedRef;

    private static readonly RenderFragment MissionsBreadcrumb =
        @<h5 class="page-nav"><span class="page-breadcrumbs"><a href="/missions"><span class="oi oi-chevron-left"></span>&nbsp;Missions</a></span></h5>;

    // OnParametersSet, not OnInitialized: following a link from one mission to another
    // (/mission/a -> /mission/b) reuses this component instance and only changes MissionRef.
    protected override async Task OnParametersSetAsync()
    {
        if (MissionRef == loadedRef)
            return;

        var requestedRef = loadedRef = MissionRef;

        // Clear the previous mission so its summary and related list don't linger while loading.
        missionData = null;
        articleData = null;
        relatedMissions = Array.Empty<Mission>();
        videoData = Array.Empty<Video>();
        hasSummary = false;

        var mission = await missionsService.GetMissionByRef(requestedRef);
        var articles = await articlesService.GetItemsByMissionRef(requestedRef);
        var missions = Array.Empty<Mission>();
        var videos = (await videoService.GetItemsByMissionRef(requestedRef))
            .Concat(await videoService.GetRelatedVideos(requestedRef))
            .GroupBy(v => v.Reference)
            .Select(g => g.First())
            .ToArray();
        if (mission != null)
        {
            var relatedArticles = await articlesService.GetRelatedItemsForMission(mission);
            articles = articles.Concat(relatedArticles).ToArray();
            missions = await missionsService.GetRelatedMissions(mission.Reference, mission.Related);
        }

        // The user may have moved on to another mission while this one was loading.
        if (requestedRef != MissionRef)
            return;

        missionData = mission;
        articleData = articles;
        relatedMissions = missions;
        videoData = videos;
    }
}
