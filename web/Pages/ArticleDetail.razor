@page "/article/{SectionRef}/{ArticleRef}"

@using Services

@inject IArticlesService dataService
@inject IMissionsService missionsService
@inject IVideoService videoService

<web.Shared.PageTitle Title="@articleData?.Title" />


@if (sectionData == null || articleData == null)
{
    <div class="loading">Loading...</div>

    @if(allArticles != null)
    {
        <h4>All Articles in @SectionRef</h4>

        <ul>
        @foreach(var article in allArticles)
        {
            <li>@article.Reference - @article.Title</li>
        }
        </ul>
    }
} else
{
    <h1><span class="sectionIcon oi @sectionData.Glyph" aria-hidden="true"></span>@articleData.Title
    <span style="float:right"><web.Controls.PdfViewButton PdfUrl="@articleData.PdfUrl" /></span>
    </h1>
    <h5 class="page-nav">
        <span class="page-breadcrumbs">
        @if (!string.IsNullOrEmpty(sectionData.Reference)) {
        <a href="/section/@sectionData.Reference"><span class="oi oi-chevron-left"></span>&nbsp;@sectionData.Title</a>
        } else {
            @sectionData.Title
        }

        @if (!string.IsNullOrEmpty(articleData.Parent?.Reference)) {
        <a href="/article/@sectionData.Reference/@articleData.Parent.Reference"><span class="oi oi-chevron-left"></span>&nbsp;@articleData.Parent.Title</a>
        }
        </span>
        @if (missionData != null)
        {
            <span class="page-mission"><a href="/mission/@missionData.Reference">@missionData.LinkText</a></span>
        }
    </h5>
    @* Hidden until the markdown has actually loaded, so an article that's only a PDF shows no empty block *@
    <div class="article-content @(hasContent ? string.Empty : "collapse")">
        <hr />
        <web.Controls.MarkdownView ContentUrl="@articleData.ContentUrl"
                                   ContentLoaded="@((bool loaded) => hasContent = loaded)" />
    </div>
    @if (RelatedArticles.Any() || relatedMissions.Any() || relatedVideos.Any())
    {
        @* Same layout as the mission page: one alphabetical list of child articles, related
           articles and related missions. *@
        <div class="related-articles">
        <hr />
        <h5>Related:</h5>
        <web.Controls.RelatedBreadcrumbList Articles=@RelatedArticles Missions=@relatedMissions Videos=@relatedVideos />
        </div>
    }
}

@code {

    [Parameter]
    public string SectionRef { get; set; }

    [Parameter]
    public string ArticleRef { get; set; }

    private Models.Section<Models.Article> sectionData;
    private Models.Article[] allArticles;
    private Models.Article articleData;
    private Models.Mission missionData;
    private Models.Mission[] relatedMissions = Array.Empty<Models.Mission>();
    private Models.Article[] relatedArticles = Array.Empty<Models.Article>();
    private Models.Video[] relatedVideos = Array.Empty<Models.Video>();
    private bool hasContent;

    // Child articles (e.g. a report's intelligence briefing) are listed with the related ones.
    private Models.Article[] RelatedArticles => (articleData?.Children ?? Array.Empty<Models.Article>())
        .Concat(relatedArticles)
        .GroupBy(a => a.Reference)
        .Select(g => g.First())
        .ToArray();

    protected override async Task OnParametersSetAsync()
    {
        // Following a link from one article to another reuses this component instance, so a
        // slower load for the previous article can finish after this one: only apply the
        // results if the route parameters are still the ones they were loaded for.
        var (sectionRef, articleRef) = (SectionRef, ArticleRef);

        var section = await dataService.GetSection(sectionRef);
        var articles = await dataService.GetAllItemsInTree(sectionRef);
        var article = await dataService.GetItem(sectionRef, articleRef);
        var mission = string.IsNullOrEmpty(article?.MissionRef)
            ? null
            : await missionsService.GetMissionByRef(article.MissionRef);

        var related = await dataService.GetRelatedItems(article);
        var missions = article == null
            ? Array.Empty<Models.Mission>()
            : await missionsService.GetRelatedMissions(article.Reference, article.Related);
        var videos = article == null
            ? Array.Empty<Models.Video>()
            : await videoService.GetRelatedVideos(article.Reference);

        if (sectionRef != SectionRef || articleRef != ArticleRef)
            return;

        sectionData = section;
        allArticles = articles;
        articleData = article;
        missionData = mission;
        relatedArticles = related;
        relatedMissions = missions;
        relatedVideos = videos;
    }
}