@page "/missions"

@using Models
@using Services

@inject IMissionsService missionService;

<h1><span class="sectionIcon oi oi-flag" aria-hidden="true"></span>Missions</h1>
<div>
    <web.Controls.MarkdownView ContentUrl="/content/missions.md"/>
</div>

@if (missions == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Name</th>
                <th>Location</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var mission in missions.OrderBy(m => m.StartDate))
            {
                <web.Controls.MissionTableRow Mission=@mission
                                               IsExpanded="@ReferenceEquals(mission, expandedMission)"
                                               OnToggle="@(() => ToggleMission(mission))" />
            }
        </tbody>
    </table>
}

@code {
    private Mission[] missions;

    private Mission expandedMission;

    // Expanding a row collapses any other; clicking the open row closes it.
    private void ToggleMission(Mission mission)
        => expandedMission = ReferenceEquals(expandedMission, mission) ? null : mission;

    protected override async Task OnInitializedAsync()
    {
        missions = await missionService.GetAllMissions();
    }
}
