@using Models
@using Services

@inject IArticlesService dataService

@* One related article per line, prefixed with a breadcrumb trail showing where it sits:
   e.g. "IC → Mission Reports → 2492-10 - Mission 'Procyon'" *@
<ul class="related-breadcrumbs">
@foreach (var item in items)
{
    <li>
        @foreach (var sec in item.Sections)
        {
            <a href="@sec.Url">@sec.BreadcrumbTitle</a>
            <span class="breadcrumb-separator" aria-hidden="true">&rarr;</span>
        }
        @foreach (var parent in item.ParentArticles)
        {
            <a href="/article/@item.SectionRef/@parent.Reference">@parent.Title</a>
            <span class="breadcrumb-separator" aria-hidden="true">&rarr;</span>
        }
        @if (!string.IsNullOrEmpty(item.Article.Reference)) {
            <a href="/article/@item.SectionRef/@item.Article.Reference">@item.Article.Title</a>
        } else {
            @item.Article.Title
        }
        &nbsp;
        <web.Controls.PdfDownloadButton PdfUrl="@item.Article.PdfUrl" />
    </li>
}
</ul>

@code {

    [Parameter]
    public Article[] Articles { get; set; } = Array.Empty<Article>();

    private List<Item> items = new();

    private sealed record Item(Article Article, Section<Article>[] Sections, Article[] ParentArticles, string SectionRef);

    protected override async Task OnParametersSetAsync()
    {
        var result = new List<Item>();
        foreach (var article in Articles ?? Array.Empty<Article>())
        {
            var sections = await dataService.GetSectionPathForItem(article);

            var parents = new List<Article>();
            for (var p = article.Parent; p != null; p = p.Parent)
                parents.Insert(0, p);

            var sectionRef = sections.LastOrDefault()?.Reference ?? Section<Article>.AllItemsRef;
            result.Add(new Item(article, sections, parents.ToArray(), sectionRef));
        }
        items = result;
    }
}
