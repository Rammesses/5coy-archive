{
  "name": "5coy-media-redirect",
  "main": "./media_worker.js",
  "compatibility_date": "2023-01-01",
  "workers_dev": false,
  "build": {
    "command": "node build-redirects.mjs"
  },
  "routes": [
    {
        "pattern": "*.5coy-cmc.org.uk/media/*",
        "zone_name": "5coy-cmc.org.uk"
    }]
}